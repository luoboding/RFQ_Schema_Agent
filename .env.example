# 复制为 .env，填写你的 DeepSeek API 密钥；不要提交 .env。
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_TIMEOUT_SECONDS=25

# IMAP SSL；请使用邮箱服务提供的应用密码。
IMAP_HOST=
IMAP_PORT=993
IMAP_USERNAME=
IMAP_PASSWORD=
IMAP_MAILBOX=INBOX
IMAP_TIMEOUT_SECONDS=30
FORGEFLOW_ADDRESS=
RFQ_BUYER_ADDRESSES=
